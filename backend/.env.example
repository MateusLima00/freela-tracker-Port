# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Banco de dados ───────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/freela_tracker

# ── JWT: Access + Refresh token (Fase 2) ─────────────────
# Gerar cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Os dois segredos DEVEM ser diferentes entre si.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Custo do bcrypt (10–14). Padrão 12.
BCRYPT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────
# Em produção, separe múltiplas origens com vírgula
CORS_ORIGIN=http://localhost:5173

# URL pública da API em produção (usado no Swagger)
API_URL=https://api.seudominio.com

# ── Seed (senhas iniciais de admin e cliente demo) ───────
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=

# ── E-mail (Fase 8 — Resend) ─────────────────────────────
# Se ausente, o envio cai em modo stub (loga no console)
RESEND_API_KEY=
EMAIL_FROM="FreelaTracker <no-reply@freelatracker.app>"

# ── Storage de imagens (Fase 7) ──────────────────────────
# Se ausente, as imagens de entregas são gravadas localmente em backend/uploads.
# Para usar Cloudinary, defina a URL no formato: cloudinary://<key>:<secret>@<cloud>
CLOUDINARY_URL=
